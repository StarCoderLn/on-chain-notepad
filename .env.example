# WalletConnect 项目 ID，去 https://cloud.walletconnect.com 免费申请
VITE_WALLETCONNECT_PROJECT_ID=your_project_id
# 部署好的合约地址，前端读取这个变量
VITE_NOTE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 以下几项只在 Hardhat 部署和验证合约时用到
# Sepolia 的 RPC 地址，去 RPC 服务商申请，比如 https://infura.io 或 https://alchemy.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_key
# 专门用于部署的钱包私钥（MetaMask 导出方式：账户菜单 > 账户详情 > 显示私钥）。
# 请用一个全新的、只放测试币的钱包，不要用装有真实资产的钱包。
PRIVATE_KEY=your_deployer_private_key
# Etherscan API Key，去 https://etherscan.io/apis 申请，用于开源验证合约代码
ETHERSCAN_API_KEY=your_etherscan_api_key
